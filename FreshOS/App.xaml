<Application x:Class="FreshOS.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
    <SolidColorBrush x:Key="FreshInk" Color="#286579"/>
    <LinearGradientBrush x:Key="FreshButton" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EEFFFFFF" Offset="0"/><GradientStop Color="#AAE4FAF9" Offset="0.48"/><GradientStop Color="#88B3EDEB" Offset="0.5"/><GradientStop Color="#DDE4FFFF" Offset="1"/></LinearGradientBrush>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource FreshInk}"/>
        <Setter Property="Background" Value="{DynamicResource FreshButton}"/>
        <Setter Property="BorderBrush" Value="#CFFFFFFF"/>
        <Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border CornerRadius="16" BorderBrush="#19ACCC" BorderThickness="2" Margin="-2"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid x:Name="PressSurface" RenderTransformOrigin=".5,.5">
                <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18">
                    <Grid><Border Margin="1" CornerRadius="17" BorderThickness="0,1,0,0" BorderBrush="#88FFFFFF" IsHitTestVisible="False"/>
                    <Border x:Name="Hover" CornerRadius="17" Background="#50FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/><Setter TargetName="Shell" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="PressSurface" Property="Margin" Value="0,1,0,-1"/><Setter TargetName="Hover" Property="Opacity" Value="0.2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="4,8"/><Setter Property="Foreground" Value="#245C69"/><Setter Property="Background" Value="#E5FFFFFF"/><Setter Property="BorderBrush" Value="#A4DBDF"/><Setter Property="SelectionBrush" Value="#58DDCF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#30FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#6073E8DC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#F0EDFFFF"/><Setter Property="Foreground" Value="#285E6B"/><Setter Property="Padding" Value="12,7"/><Setter Property="BorderBrush" Value="White"/></Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="#F0ECFFFD"/><Setter Property="Foreground" Value="#285E6B"/><Setter Property="BorderBrush" Value="White"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Padding" Value="12,8"/></Style>

    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="42"/><Setter Property="Focusable" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Margin="0,4"><Border Height="32" CornerRadius="16" Background="#58DBEB" BorderBrush="#D9FFFFFF" BorderThickness="1"/>
                <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="30" CornerRadius="15,0,0,15"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F6FFD0" Offset="0"/><GradientStop Color="#41FF00" Offset="0.48"/><GradientStop Color="#2CE600" Offset="0.52"/><GradientStop Color="#D2FFAD" Offset="1"/></LinearGradientBrush></Border.Background></Border></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="30" CornerRadius="0,15,15,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#ECFFFF" Offset="0"/><GradientStop Color="#00D4F2" Offset="0.5"/><GradientStop Color="#8FF5FF" Offset="1"/></LinearGradientBrush></Border.Background></Border></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb Width="16" Height="42" Cursor="Hand"><Thumb.Template><ControlTemplate><Grid><Border Width="2" Height="27" Background="#87959A" VerticalAlignment="Top" Margin="0,4,0,0"/><Border Width="14" Height="11" CornerRadius="4" VerticalAlignment="Top" BorderBrush="#82FFFFFF" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White" Offset="0"/><GradientStop Color="#919C9D" Offset="0.6"/><GradientStop Color="#E3EBEC" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="8,10"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><DockPanel LastChildFill="True">
            <Grid Width="44" Height="25" Margin="0,0,12,0" VerticalAlignment="Center"><Border x:Name="Well" CornerRadius="13" Background="#50779A9F" BorderBrush="#A0FFFFFF" BorderThickness="1"/><Border x:Name="Knob" Width="19" Height="19" CornerRadius="10" HorizontalAlignment="Left" Margin="3,0,3,0" Background="#F4FFFFFF" BorderBrush="#91D8DF" BorderThickness="1"/></Grid>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </DockPanel><ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Well" Property="Background" Value="#27DDB1"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Well" Property="BorderBrush" Value="#176D8C"/><Setter TargetName="Well" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
</Application.Resources></Application>
